# LLM Experiments Lab — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored; .env.example is tracked.
# Non-secret config lives in config/settings.py

# ── API Keys ──
OPENAI_API_KEY=
# Nebius Token Factory API key. Get one at https://nebius.com/services/ai-studio
# Free tier credits are enough to run every example scenario many times.
NEBIUS_KEY=


NEBIUS_PROFILE=
NEBIUS_PROJECT_ID=
# NEBIUS_SA_ID=serviceaccount-...
# NEBIUS_SA_PUBLIC_KEY_ID=publickey-...
# NEBIUS_SA_PRIVATE_KEY_FILE=/home/nodozi/.nebius/sa_private.pem
REGION_ID=eu-north1
REGISTRY_ID=registry-e00fjx4k9nbq206gh4
REGISTRY_PATH=e00fjx4k9nbq206gh4
IMAGE=cr.eu-north1.nebius.cloud/e00fjx4k9nbq206gh4/llm-lab-backend:phase2
AUTH_TOKEN=
NEBIUS_SUBNET_ID=
# NEBIUS_SUBNET_ID=default-subnet-1tmjek83 # this was subnet for the endpoint we were assigned when testing. when i tried to use it to create the nebius jobs it errored and so i just used SUBNET_ID 

# Recommendation: Keep .env clean (no export), but always source with set -a:

# set -a && . .env && set +a