{
  "name": "Snapshot nanoGPT",
  "description": "GPT-2 style nanoGPT, ~124M params (vs 1.8M baseline). Real GPT-2 BPE tokenizer instead of character-level. Token embeddings reused as the LM head (weight tying).",
  "template": "nanogpt",
  "model": {
    "vocab_size": 50304,
    "block_size": 1024,
    "n_embd": 768,
    "n_head": 12,
    "n_layer": 12,
    "dropout": 0.0,
    "pos_encoding": "learned",
    "activation": "gelu",
    "bias": false,
    "tie_weights": true
  },
  "training": {
    "batch_size": 12,
    "learning_rate": 0.0003,
    "weight_decay": 0.1,
    "betas": [
      0.9,
      0.95
    ],
    "warmup_iters": 200,
    "lr_decay_iters": 3000,
    "min_lr": 3e-05,
    "grad_accum_steps": 5,
    "max_iters": 3000,
    "eval_interval": 10,
    "eval_iters": 2,
    "optimizer": "adamw"
  },
  "inference": {
    "max_new_tokens": 100,
    "temperature": 0.8
  },
  "dataset": "tiny_shakespeare",
  "data": {
    "dataset": "tiny_shakespeare",
    "tokenizer": "gpt2",
    "tokenizer_artifact": "gpt2.json",
    "vocab_size": 50304
  }
}