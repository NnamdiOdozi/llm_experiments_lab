FROM python:3.12.12-slim

WORKDIR /app

RUN pip install uv

COPY pyproject.toml uv.lock* ./
RUN uv sync --no-dev

COPY backend ./backend
COPY config ./config

ENV PYTHONPATH=/app
ENV HOST=0.0.0.0
ENV PORT=8000
ENV GPU_YIELD_ENABLED=false

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]