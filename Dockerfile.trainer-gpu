# nvidia/cuda base (not plain python:slim) — matches the exact image the
# plan doc's GPU smoke test already used. Needed for nvidia-smi and the
# CUDA driver-level libraries to actually be present; a plain slim image
# isn't guaranteed to have either, which would silently break the GPU
# utilization metrics (backend/training/train_worker.py). Ubuntu 24.04
# ships Python 3.12 by default, matching the CPU image's version.
FROM nvidia/cuda:13.1.1-runtime-ubuntu24.04

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Official installer, not pip — avoids Ubuntu 24.04's PEP 668
# externally-managed-environment restriction entirely.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# See Dockerfile.trainer-cpu: uv's wheel download cache persists inside a
# Docker layer even after packages are uninstalled. Not load-bearing here
# (nothing gets uninstalled in this image), but the full cu130 wheel set
# would otherwise be cached twice for no reason — once as installed
# packages, once as cache. See docs/DESIGN_DECISIONS.md.
ENV UV_NO_CACHE=1

COPY pyproject.toml uv.lock ./
# pyproject.toml's torch source already points at the cu130 (CUDA) wheel
# index for Linux/Windows — no swap needed here, unlike the CPU image.
RUN uv sync --no-dev

COPY backend ./backend
COPY config ./config

ENV PYTHONPATH=/app
ENV HOST=0.0.0.0
ENV PORT=8000
# Not WSL2 — no shared display compositor to starve. See config/settings.py.
ENV GPU_YIELD_ENABLED=false

EXPOSE 8000

# --no-sync: run against the venv exactly as baked, skip uv's
# reconcile-against-lock check on every container start. Not load-bearing
# here (no package swap happens in this image, so there's nothing to
# revert) but kept consistent with Dockerfile.trainer-cpu, where it fixes a
# real bug — see docs/DESIGN_DECISIONS.md. Also shaves the resync check off
# every cold start, which matters for an idle-timeout endpoint.
CMD ["uv", "run", "--no-sync", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
