FROM python:3.12.12-slim

WORKDIR /app

RUN pip install uv

# docker/cpu/pyproject.toml is a separate, self-contained uv project whose
# torch source is pinned unconditionally to the CPU wheel index — unlike
# the root pyproject.toml (used for local dev), it never resolves or
# downloads anything from the cu130 index in the first place. This
# replaced an earlier approach that synced the CUDA-pinned root lockfile
# and then swapped/stripped torch afterward — that produced a 5.81GB image
# because the full cu130 dependency tree got installed (and cached) before
# being partially undone. See docs/DESIGN_DECISIONS.md §12.
ENV UV_NO_CACHE=1
COPY docker/cpu/pyproject.toml docker/cpu/uv.lock ./
RUN uv sync --no-dev

COPY backend ./backend
COPY config ./config
# Tokenizer artifacts + manifest module. backend.api.experiments imports
# data.tokenizers.manifest at load time, and BPE runs load the *.json artifacts
# via Tokenizer.from_file — without this the worker fails to start (char AND
# BPE). 2026-08-06.
COPY data/tokenizers ./data/tokenizers

ENV PYTHONPATH=/app
ENV HOST=0.0.0.0
ENV PORT=8000
# Not WSL2 — no shared display compositor to starve. See config/settings.py.
ENV GPU_YIELD_ENABLED=false

EXPOSE 8000

# --no-sync: run against the venv exactly as baked, skip uv's
# reconcile-against-lock check on every container start. Not load-bearing
# anymore (docker/cpu/uv.lock already matches what's installed, so there's
# nothing to revert), but kept as a defensive habit — it also shaves the
# resync check off every cold start, which matters for an idle-timeout
# endpoint. See docs/DESIGN_DECISIONS.md.
CMD ["uv", "run", "--no-sync", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
